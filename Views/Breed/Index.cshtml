@model EjemploMVC.Models.DogBreedListViewModel

@{
    ViewData["Title"] = "Razas de Perros";
}

<div class="container-fluid text-center">
    <h1>Lista de Razas de Perros</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex flex-wrap justify-content-center gap-4">
        @foreach (var raza in Model.Razas)
        {
            <div class="card" style="width: 18rem;">
                @if (raza.Attributes.Images != null && raza.Attributes.Images.Count > 0)
                {
                    <img src="@raza.Attributes.Images[0].Thumb" class="card-img-top" alt="@raza.Attributes.Name"
                         style="height: 200px; width: 100%; object-fit: contain; object-position: center;" />
                }
                <div class="card-body d-flex flex-column justify-content-between text-start">
                    <h5 class="card-title text-center">@raza.Attributes.Name</h5>
                    <p class="card-text mb-1"><strong>Pais de origen:</strong> @raza.Attributes.Origin?.Country</p>
                    <p class="card-text mb-1"><strong>Tipo de pelaje:</strong> @raza.Attributes.Coat?.Type</p>
                    <p class="card-text mb-1"><strong>Tendencia a ladrar:</strong> @raza.Attributes.Traits?.Barking / 5</p>
                    <p class="card-text mb-2"><strong>Convivencia con niños:</strong> @raza.Attributes.Traits?.GoodWithChildren / 5</p>
                    <a asp-controller="Breed" asp-action="Details" asp-route-id="@raza.Id"
                       class="btn btn-primary">Ver detalles</a>
                </div>
            </div>
        }
    </div>

    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-controller="Breed" asp-action="Index"
                   asp-route-page="@(Model.PaginaActual - 1)">&laquo; Anterior</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Pagina @Model.PaginaActual</span>
            </li>
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-controller="Breed" asp-action="Index"
                   asp-route-page="@(Model.PaginaActual + 1)">Siguiente &raquo;</a>
            </li>
        </ul>
    </nav>
</div>
