@model EjemploMVC.Models.DogBreedResource

@{
    ViewData["Title"] = Model.Attributes.Name;
}

<div class="container-fluid text-center">
    <h1>@Model.Attributes.Name</h1>

    @if (Model.Attributes.Images != null && Model.Attributes.Images.Count > 0)
    {
        <img src="@Model.Attributes.Images[0].Medium" alt="@Model.Attributes.Name" class="img-fluid rounded mb-3" style="max-height: 300px;" />
    }

    <div class="row justify-content-center">
        <div class="col-6 text-start">
            <p><strong>Descripcion:</strong> @Model.Attributes.Description</p>
            <p><strong>Esperanza de vida:</strong> @Model.Attributes.Life.Min - @Model.Attributes.Life.Max años</p>
            <p><strong>Peso macho:</strong> @Model.Attributes.MaleWeight.Min - @Model.Attributes.MaleWeight.Max kg</p>
            <p><strong>Peso hembra:</strong> @Model.Attributes.FemaleWeight.Min - @Model.Attributes.FemaleWeight.Max kg</p>
            <p><strong>Altura macho:</strong> @Model.Attributes.MaleHeight?.Min - @Model.Attributes.MaleHeight?.Max cm</p>
            <p><strong>Altura hembra:</strong> @Model.Attributes.FemaleHeight?.Min - @Model.Attributes.FemaleHeight?.Max cm</p>
            <p><strong>Hipoalergenico:</strong> @(Model.Attributes.Hypoallergenic ? "Si" : "No")</p>
            <p><strong>Pais de origen:</strong> @Model.Attributes.Origin?.Country</p>
            <p><strong>Tipo de pelaje:</strong> @Model.Attributes.Coat?.Type</p>
            <p><strong>Tendencia a ladrar:</strong> @Model.Attributes.Traits?.Barking / 5</p>
            <p><strong>Facilidad para entrenar:</strong> @Model.Attributes.Traits?.Trainability / 5</p>
            <p><strong>Convivencia con niños:</strong> @Model.Attributes.Traits?.GoodWithChildren / 5</p>

            <a class="btn btn-primary" asp-controller="Breed" asp-action="Index" role="button">Volver a la Lista</a>
        </div>
    </div>
</div>
