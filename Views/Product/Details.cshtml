@model Product

@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid text-center">
    <h1>@Model.Title</h1>
    <div class="row">
        <div class="col-4">
            <img src="@Model.Image" alt="@Model.Title" class="img-fluid"/>

        </div>
        <div class="col-4">
            <h3>$ @Model.Price</h3>
            <p>@Model.Description</p>
            <a class="btn btn-primary" asp-controller="Product" asp-action="Index" role="button">Volver a la Lista</a>
        </div>
    </div>
</div>